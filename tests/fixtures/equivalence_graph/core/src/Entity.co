abstract class is Scored {
  string NameValue;
  int32 Value;

  Entity(string name, int32 value) {
    NameValue = name;
    Value = value;
  }

  override func Name(): string {
    return NameValue;
  }

  override func Score(): int32 {
    return Value;
  }

  func Label(): string {
    return "Entity";
  }

  abstract func Copy(): Entity;
}
